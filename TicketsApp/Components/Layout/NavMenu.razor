@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime _Js
@inject NavigationManager _Navegador

<MudNavMenu Class="mt-4" Color="Color.Info" Bordered="true">
    <MudStack>
        <AuthorizeView Roles="Admin, Analista">
            <Authorized>
                <MudNavLink Href="/Inicio" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Home" Ripple>
                    Inicio
                </MudNavLink>
            </Authorized>
        </AuthorizeView>
        <MudNavLink Href="/Tickets" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocalActivity" ForceLoad>
            Tickets
        </MudNavLink>
        <MudNavLink Href="/UsuarioTickets" Icon="@Icons.Material.Filled.EventNote">Nuevo
            Tickets
        </MudNavLink>
        <AuthorizeView Roles="Admin, Analista">
            <Authorized>
                <MudNavLink Href="/PlantillasTickets" Icon="@Icons.Material.Filled.CreateNewFolder">
                    Plantillas
                </MudNavLink>
                <MudNavGroup Title="Catalogos" Icon="@Icons.Material.Filled.Dataset">
                    <MudNavLink Href="Proveedores" Icon="@Icons.Material.Filled.ContactEmergency">
                        Proveedores
                    </MudNavLink>
                    <MudNavLink Href="/Unidades" Icon="@Icons.Material.Filled.Business">Unidades
                    </MudNavLink>
                    <MudNavLink Href="/Departamentos" Icon="@Icons.Material.Filled.Groups">
                        Departamentos
                    </MudNavLink>
                    <MudNavLink Href="/Categorias" Icon="@Icons.Material.Filled.Category">
                        Categorias
                    </MudNavLink>
                </MudNavGroup>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudNavLink Href="/Usuarios" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">
                    Usuarios</MudNavLink>
                </Authorized>
            </AuthorizeView>
            <MudNavLink Onclick="CerrarSesion" Icon="@Icons.Material.Filled.ExitToApp">Cerrar
                Sesión
            </MudNavLink>
        </MudStack>
    </MudNavMenu>

@code {
    private async Task CerrarSesion()
    {
        var respuesta = await _Js.InvokeAsync<bool>("cerrarSesion");

        if (respuesta)
        {
            _Navegador.NavigateTo("/InicioDesesion", true);
        }
    }
}