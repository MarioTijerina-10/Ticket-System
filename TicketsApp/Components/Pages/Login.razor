@page "/InicioDeSesion"
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject SignInManager<Usuario> _SignInManager
@inject NavigationManager _Navegador
@inject HttpClient _Http
@inject AuthenticationStateProvider _Autenticacion
@inject IJSRuntime _Js

@code {
    LoginUsuario credenciales = new();
    MudForm form_login = new();
    bool loginValido = true;

    private async Task LoginUsuario()
    {
        await form_login.ValidateAsync();

        if (form_login.IsValid)
        {
            var respuesta = await _Js.InvokeAsync<bool>("login", credenciales);

            if (respuesta)
            {
                loginValido = true;
                _Navegador.NavigateTo("/Inicio", true); // reload → auth applied
            }
            else
            {
                loginValido = false;
            }
        }
    }
}

<MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Style="height: 80vh;">
    <MudGrid Justify="Justify.Center" Class="ps-a">
        <MudItem xs="10" sm="6" md="5" lg="5">
            <MudPaper Class="pa-8">
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="ma-3 border-solid">
                    <MudStack Row>
                        <MudImage Src="/Images/ticket-system-logo.png" Height="40" />
                        <MudText Typo="Typo.h4">Ticket-System</MudText>
                    </MudStack>
                    <MudText Typo="Typo.h6">Inicio de Sesion</MudText>
                </MudStack>
                <MudSpacer />
                <MudForm @ref="form_login" Model="@credenciales">
                    <MudStack Class="pa-5 border-solid border mud-border-primary"
                              Style="border-color: white !important;">
                        <MudText>Usuario</MudText>
                        <MudTextField @bind-Value="credenciales.Usuario" Required RequiredError="Campo Requerido.."
                                      Variant="Variant.Outlined" MaxLength="25" />
                        <MudText>Contraseña</MudText>
                        <MudTextField @bind-Value="credenciales.Contraseña" Required RequiredError="Campo Requerido.."
                                      Variant="Variant.Outlined" InputType="InputType.Password" MaxLength="25" />
                        <MudButton Size="Size.Large" Color="Color.Info" OnClick="LoginUsuario">Iniciar Sesion
                        </MudButton>

                        @if (!loginValido)
                        {
                            <MudAlert Severity="@Severity.Error">Usuario o Contraseña no validos</MudAlert>
                        }
                    </MudStack>
                </MudForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>