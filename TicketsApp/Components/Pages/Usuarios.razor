@page "/Usuarios"
@inherits ComponenteBase
@attribute [Authorize(Roles = "Admin")]
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@using TicketsApp.DTO.CamposEstaticos
@using TicketsApp.DTO.Usuarios
@using TicketsApp.DTO.Departamentos
@using TicketsApp.Services
@inject ServicioUsuarios _ServicioUsuarios
@inject ServicioUnidades _ServicioUnidades
@inject ServicioCamposEstaticos _ServicioDatos
@inject ServicioDepartamentos _ServicioDepartamentos
@inject IDialogService _ServicioDialogo
@inject ISnackbar _SnackBar

@code {
    @* VARIABLES DE MODALES USADOS *@
    private MudDialog modal_UsuarioNuevo = null!;
    private MudDialog modal_UsuarioActualizado = null!;
    List<GetUsuario> usuarios = new();
    List<GetUsuario> usuariosFiltrados = new();
    List<Unidad> unidades = new();
    List<GetDepartamentos> departamentos = new();
    List<IdentityRole> roles = new();
    CreateUsuario nuevoUsuario = new();
    UpdateUsuario usuarioActualizado = new();
    FiltroDeUsuarios filtrado = new();
    string usuarioActualizadoId = "";
    private MudForm _form_editar = null!;
    private MudDataGrid<GetUsuario> dataGrid = null!;
    private DialogOptions dialogOptions => new()
    {
        MaxWidth = MaxWidth.Large,
        FullWidth = true,
        FullScreen = isMobile
    };

    protected override async Task OnInitializedAsync()
    {
        //SACAR USUARIOS DE BASE DE DATOS
        await GetUsuarios();

        //DATOS PARA EL FORMULARIO
        roles = await _ServicioDatos.GetRoles();
        unidades = (await _ServicioUnidades.GetAllUnidades()).data ?? unidades;
        departamentos = (await _ServicioDepartamentos.GetAll()).data ?? departamentos;

        //VALORES DEFAULT PARA SELECTORES NUEVO
        if (unidades.Any())
        {
            unidadSeleccionada = unidades.First().Id;
        }
        else
        {
            ExistenUnidades = false;
        }

        if (departamentos.Any())
        {
            departamentoSeleccionado = departamentos.First().Id;
        }
        else
        {
            ExistenDepartamentos = false;
        }
    }

    private async Task GetUsuarios()
    {
        //LISTA DE USUARIOS
        usuarios = (await _ServicioUsuarios.GetAll()).data!;
        usuariosFiltrados = usuarios;
        await dataGrid.ReloadServerData();
    }

    private async Task ShowDialogoCrear()
    {
        await modal_UsuarioNuevo.ShowAsync("Usuario Nuevo", dialogOptions);
    }

    private async Task ShowDialogoActualizar(GetUsuario usuario)
    {
        usuarioActualizadoId = usuario.Id;
        usuarioActualizado.Correo = usuario!.Correo;
        usuarioActualizado.Rol = usuario.Rol.FirstOrDefault()!;
        departamentoSeleccionado = usuario.FkDepartamento;
        unidadSeleccionada = usuario.FkUnidad;
        usuarioActualizado.Nombre = usuario!.Nombre;
        usuarioActualizado.Usuario1 = usuario!.Usuario;
        usuarioActualizado.Contraseña = usuario!.ContraseñaVisible;

        await modal_UsuarioActualizado.ShowAsync("Actualizar Usuario", dialogOptions);
    }
}

<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />

@code {
    bool isMobile;

    private void OnBreakpointChanged(Breakpoint bp)
    {
        isMobile = bp <= Breakpoint.Sm;
        StateHasChanged();
    }
}

@* BOTONES *@
<MudButton Color="Color.Info" Variant="Variant.Filled" Class="mb-3" FullWidth="@isMobile" OnClick="ShowDialogoCrear"
           StartIcon="@Icons.Material.Filled.AddCircle">
    Añadir Usuario
</MudButton>

<div class="grid-responsive">
    <MudDataGrid T="GetUsuario" Items="@usuariosFiltrados" SortMode="SortMode.Multiple" Filterable="true"
                 @ref="dataGrid" FilterMode="@DataGridFilterMode.ColumnFilterMenu" FixedHeader="true"
                 Height="calc(100vh - 220px)" Dense="@isMobile">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Usuarios Registrados</MudText>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Usuario" Filterable="false"></PropertyColumn>
            <TemplateColumn Title="Nombre" Filterable="true" Sortable="true">
                <CellTemplate Context="x">
                    @x.Item.Nombre
                </CellTemplate>
                <FilterTemplate>
                    <MudTextField Label="Nombre" Value="@filtrado.Nombre"
                                  ValueChanged="@(async (string? v) => await AsignarValorFiltro(v, x => filtrado.Nombre = x))"
                                  Immediate="true" Clearable="true" />
                </FilterTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Rol" Filterable="true" Sortable="true">
                <CellTemplate Context="x">
                    @x.Item.Rol.FirstOrDefault()
                </CellTemplate>
                <FilterTemplate>
                    <MudSelect Label="Rol" Value="@filtrado.Rol"
                               ValueChanged="@(async (string? v) => await AsignarValorFiltro(v, x => filtrado.Rol = x))"
                               Clearable="true">
                        @foreach (var x in roles)
                        {
                            <MudSelectItem Value="@(x.Name)">@x.Name</MudSelectItem>
                        }
                    </MudSelect>
                </FilterTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Departamento" Filterable="true" Sortable="true" Hidden="@isMobile">
                <CellTemplate Context="x">
                    @x.Item.Departamento
                </CellTemplate>
                <FilterTemplate>
                    <MudSelect Label="Departamento" Value="@filtrado.FkDepartamento"
                               ValueChanged="@(async (int? v) => await AsignarValorFiltro(v, x => @filtrado.FkDepartamento = x))"
                               Clearable="true">
                        @foreach (var x in departamentos)
                        {
                            <MudSelectItem Value="@((int?)x.Id)">@x.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </FilterTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Unidad" Filterable="true" Sortable="true" Hidden="@isMobile">
                <CellTemplate Context="x">
                    @x.Item.Unidad
                </CellTemplate>
                <FilterTemplate>
                    <MudSelect T="int?" Label="Unidad" Value="@filtrado.FkUnidad"
                               ValueChanged="@(async (int? v) => await AsignarValorFiltro(v, x => @filtrado.FkUnidad = x))"
                               Clearable="true">
                        @foreach (var x in unidades)
                        {
                            <MudSelectItem Value="@((int?)x.Id)">@x.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </FilterTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Correo" Filterable="false" Hidden="@isMobile" />
            <TemplateColumn Title="Acciones" StickyRight="true">
                <CellTemplate Context="x">
                    <MudStack Row Spacing="1" Wrap="Wrap.NoWrap">
                        @if (isMobile)
                        {
                            <MudIconButton Size="Size.Small" Color="Color.Warning"
                                           Icon="@Icons.Material.Filled.DeleteForever"
                                           OnClick="() => CofirmarEliminacion(x.Item.Id)" />
                            <MudIconButton Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Edit"
                                           OnClick="() => ShowDialogoActualizar(x.Item)" />
                        }
                        else
                        {
                            <MudButton Color="Color.Warning" EndIcon="@Icons.Material.Filled.DeleteForever"
                                       OnClick="() => CofirmarEliminacion(x.Item.Id)">Eliminar</MudButton>
                            <MudButton Color="Color.Info" EndIcon="@Icons.Material.Filled.Edit"
                                       OnClick="() => ShowDialogoActualizar(x.Item)">Editar</MudButton>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</div>

@code {
    //CONFIRMACION PARA ELIMINAR USUARIO
    private async Task CofirmarEliminacion(string id)
    {
        bool? respuesta = await _ServicioDialogo.ShowMessageBoxAsync("Eliminar Usuario?", "Esta seguro de querer elinar este registro?", yesText: "Eliminar", cancelText: "Cancel");

        if (respuesta != null && respuesta == true)
        {
            var resultado = await _ServicioUsuarios.DeleteUsuario(id);
            _SnackBar.Add(resultado.mensaje, resultado.exitoso ? Severity.Warning : Severity.Error);
            await GetUsuarios();
        }
    }
}

@code {
    private MudForm _form_Crear = null!;
}

@* MODAL PARA CREAR USUARIOS *@
<MudDialog @ref="modal_UsuarioNuevo">
    <DialogContent>
        <MudForm @ref="_form_Crear" Model="@nuevoUsuario">
            <MudGrid Spacing="2" Class="pb-3">
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField Label="Usuario" @bind-Value="nuevoUsuario.Usuario1" Required
                                  RequiredError="Campo Requerido.." Variant="Variant.Outlined" MaxLength="25" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField Label="Contraseña" @bind-Value="nuevoUsuario.Contraseña" Required
                                  RequiredError="Campo Requerido.." Variant="Variant.Outlined" MaxLength="25" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField Label="Nombre Completo" @bind-Value="nuevoUsuario.Nombre" Required
                                  RequiredError="Campo Requerido.." Variant="Variant.Outlined" MaxLength="50" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField Label="Correo" @bind-Value="nuevoUsuario.Correo" Variant="Variant.Outlined"
                                  MaxLength="50" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="string" @bind-Value="nuevoUsuario.Rol" Label="Rol" Required
                               RequiredError="Campo Requerido.." Variant="Variant.Outlined">
                        @foreach (var x in roles)
                        {
                            <MudSelectItem Value="x.Name">@x.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int?" @bind-Value="unidadSeleccionada" Label="Unidad" Required
                               RequiredError="Campo Requerido.." Variant="Variant.Outlined" Disabled="!ExistenUnidades">
                        @foreach (var x in unidades)
                        {
                            <MudSelectItem Value="@((int?)x.Id)">@x.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int?" @bind-Value="departamentoSeleccionado" Label="Departamento" Required
                               RequiredError="Campo Requerido.." Variant="Variant.Outlined" Disabled="!ExistenDepartamentos">
                        @foreach (var x in departamentos)
                        {
                            <MudSelectItem Value="@((int?)x.Id)">@x.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="CrearUsuario" StartIcon="@Icons.Material.Filled.Save">Guardar
        </MudButton>
    </DialogActions>
</MudDialog>


@code {
    int? departamentoSeleccionado = null;
    int? unidadSeleccionada = null;

    //CREAR USUARIO, RECARGAR TABLA Y RESETEAR USUARIO NUEVO
    private async Task CrearUsuario()
    {

        await _form_Crear.ValidateAsync();

        if (_form_Crear.IsValid)
        {
            nuevoUsuario.FkDepartamento = (int)departamentoSeleccionado!;
            nuevoUsuario.FkUnidad = (int)unidadSeleccionada!;
            var respuesta = (await _ServicioUsuarios.CrearUsuario(nuevoUsuario));

            if (respuesta.exitoso)
            {
                await GetUsuarios();
                nuevoUsuario = new();
                nuevoUsuario.Rol = roles.First().Name!;
                unidadSeleccionada = unidades.First().Id;
                departamentoSeleccionado = departamentos.First().Id;
                await modal_UsuarioNuevo.CloseAsync();
                _SnackBar.Add(respuesta.mensaje, Severity.Success);
            }
            else
            {
                _SnackBar.Add(respuesta.mensaje, Severity.Error);
            }
        }
    }
}

