        <MudButton Color="Color.Primary" OnClick="ActualizarUsuario" StartIcon="@Icons.Material.Filled.Save">Actualizar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private async Task ActualizarUsuario()
    {
        await _form_editar.ValidateAsync();
        if (_form_editar.IsValid)
        {
            usuarioActualizado.FkDepartamento = (int)departamentoSeleccionado!;
            usuarioActualizado.FkUnidad = (int)unidadSeleccionada!;
            var respuesta = await _ServicioUsuarios.UpdateUsuario(usuarioActualizado, usuarioActualizadoId);

            if (respuesta.exitoso == true)
            {
                await GetUsuarios();
                await modal_UsuarioActualizado.CloseAsync();
                unidadSeleccionada = unidades.First().Id;
                departamentoSeleccionado = departamentos.First().Id;

                _SnackBar.Add(respuesta.mensaje, Severity.Info);
            }
            else
            {
                _SnackBar.Add(respuesta.mensaje, Severity.Error);
            }
        }
    }
}

@* FILTRAR USUARIOS *@
@code {

    protected override async Task filtrar()
    {
        usuariosFiltrados = (await _ServicioUsuarios.FiltrarUsuarios(filtrado, usuarios)).data ?? new();
        await dataGrid.ReloadServerData();
    }

    bool ExistenDepartamentos = true;
    bool ExistenUnidades = true;
}