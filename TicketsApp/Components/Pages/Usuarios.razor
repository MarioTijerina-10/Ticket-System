@page "/Usuarios"
@using System.Threading.Tasks
@using System.Text.Json
@using TicketsApp.DTO.CamposEstaticos
@using TicketsApp.DTO.Usuarios
@using TicketsApp.Services
@inject ServicioUsuarios _ServicioUsuarios
@inject ServicioCamposEstaticos _ServicioDatos
@inject IDialogService _ServicioDialogo

@code {
    @* VARIABLES DE MODALES USADOS *@
    private MudDialog modal_UsuarioNuevo = null!;
    private MudDialog modal_UsuarioActualizado = null!;
    List<GetUsuario> usuarios = new();
    List<Unidad> unidades = new();
    List<IdentityRole> roles = new();
    CreateUsuario nuevoUsuario = new();
    UpdateUsuario usuarioActualizado = new();
    string usuarioActualizadoId = "";
    private MudDataGrid<GetUsuario> dataGrid = null!;
    private DialogOptions dialogOptions = new DialogOptions
    {
        Position = DialogPosition.Center,
        CloseButton = true,
        MaxWidth =
    MaxWidth.ExtraLarge
    };

    protected override async Task OnInitializedAsync()
    {
        //SACAR USUARIOS DE BASE DE DATOS
        await GetUsuarios();

        //DATOS PARA EL FORMULARIO
        roles = await _ServicioDatos.GetRoles();
        unidades = await _ServicioDatos.GetUnidades();

        //VALORES DEFAULT PARA USUARIO NUEVO
        nuevoUsuario.FkUnidad = unidades.FirstOrDefault()!.Id;
    }

    private async Task GetUsuarios()
    {
        //LISTA DE USUARIOS
        usuarios = (await _ServicioUsuarios.GetAll()).data!;
        await dataGrid.ReloadServerData();
    }

    protected override async Task OnAfterRenderAsync(bool firstrender)
    {
    }

    protected override async Task OnParametersSetAsync()
    {
    }

    private async Task ShowDialogoCrear()
    {
        await modal_UsuarioNuevo.ShowAsync("Usuario Nuevo", dialogOptions);
    }

    private async Task ShowDialogoActualizar(GetUsuario usuario)
    {
        usuarioActualizadoId = usuario.Id;
        usuarioActualizado.Contraseña = usuario!.Contraseña;
        usuarioActualizado.Correo = usuario!.Correo;
        usuarioActualizado.Rol = usuario.Rol.FirstOrDefault()!;
        usuarioActualizado.FkUnidad = (int)usuario!.Unidad;
        usuarioActualizado.Nombre = usuario!.Nombre;
        usuarioActualizado.Usuario1 = usuario!.Usuario;

        await modal_UsuarioActualizado.ShowAsync("Actualizar Usuario", dialogOptions);
    }
}

@* BOTONES *@
<MudButton Color="Color.Info" @onclick="ShowDialogoCrear">Añadir
    Usuario</MudButton>

<MudDataGrid T="GetUsuario" Items="usuarios" SortMode="SortMode.Multiple" Filterable="true" @ref="dataGrid">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Usuarios Registrados</MudText>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Usuario"></PropertyColumn>
        <PropertyColumn Property="x => x.Contraseña"></PropertyColumn>
        <PropertyColumn Property="x => x.Nombre"></PropertyColumn>
        <PropertyColumn Property="x => x.Rol.LastOrDefault()"></PropertyColumn>
        <PropertyColumn Property="x => x.Unidad"></PropertyColumn>
        <PropertyColumn Property="x => x.Correo"></PropertyColumn>
        <TemplateColumn>
            <CellTemplate Context="x">
                <MudStack Row>
                    <MudButton Size="@Size.Medium" Color="Color.Warning" OnClick="() => CofirmarEliminacion(x.Item.Id)">
                        Eliminar</MudButton>
                    <MudButton Size="@Size.Medium" Color="Color.Info" OnClick="() => ShowDialogoActualizar(x.Item)">
                        Editar
                    </MudButton>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    //CONFIRMACION PARA ELIMINAR USUARIO
    private async Task CofirmarEliminacion(string id)
    {
        bool? respuesta = await _ServicioDialogo.ShowMessageBoxAsync("Eliminar Usuario?", "Esta seguro de querer elinar este registro?", yesText: "Eliminar", cancelText: "Cancel");

        if (respuesta != null && respuesta == true)
        {
            await _ServicioUsuarios.DeleteUsuario(id);
            await GetUsuarios();
        }
    }
}

@code {
    private MudForm _form_Crear = null!;
}

@* MODAL PARA CREAR USUARIOS *@
<MudDialog @ref="modal_UsuarioNuevo">
    <DialogContent>
        <MudForm @ref="_form_Crear" Model="@nuevoUsuario">
            <MudStack Row Spacing="7" Class="pb-3">
                <MudTextField Label="Usuario" @bind-Value="nuevoUsuario.Usuario1" Required Variant="Variant.Outlined">
                </MudTextField>
                <MudTextField Label="Contraseña" @bind-Value="nuevoUsuario.Contraseña" Required
                    Variant="Variant.Outlined">
                </MudTextField>
                <MudTextField Label="Nombre Completo" @bind-Value="nuevoUsuario.Nombre" Required
                    Variant="Variant.Outlined">
                </MudTextField>
            </MudStack>
            <MudStack Row Spacing="7" Class="pb-3">
                <MudTextField Label="Correo" @bind-Value="nuevoUsuario.Correo" Variant="Variant.Outlined">
                </MudTextField>
                <MudSelect T="string" @bind-Value="nuevoUsuario.Rol" Label="Rol" Required Variant="Variant.Outlined">
                    @foreach (var x in roles)
                    {
                        <MudSelectItem Value="x.Name">@x.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int" @bind-Value="nuevoUsuario.FkUnidad" Label="Unidad" Required
                    Variant="Variant.Outlined">
                    @foreach (var x in Enum.GetValues<Enumerables.Unidades>())
                    {
                        <MudSelectItem Value="@((int)x)">@x</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="CrearUsuario">Guardar</MudButton>
    </DialogActions>
</MudDialog>


@code {
    //CREAR USUARIO, RECARGAR TABLA Y RESETEAR USUARIO NUEVO
    private async Task CrearUsuario()
    {
        await _form_Crear.ValidateAsync();

        if (_form_Crear.IsValid)
        {
            await _ServicioUsuarios.CreateUsuario(nuevoUsuario);

            await GetUsuarios();
            nuevoUsuario = new();
            nuevoUsuario.Rol = roles.FirstOrDefault()!.Id;
            nuevoUsuario.FkUnidad = unidades.FirstOrDefault()!.Id;
            await modal_UsuarioNuevo.CloseAsync();
        }
    }
}

@* MODAL PARA ACTUALIZAR USUARIOS *@
<MudDialog @ref="modal_UsuarioActualizado">
    <DialogContent>
        <MudForm @ref="_form_Crear" Model="@usuarioActualizado">
            <MudStack Row Spacing="7" Class="pb-3">
                <MudTextField Label="Usuario" @bind-Value="usuarioActualizado.Usuario1" Required
                    Variant="Variant.Outlined">
                </MudTextField>
                <MudTextField Label="Contraseña" @bind-Value="usuarioActualizado.Contraseña" Required
                    Variant="Variant.Outlined">
                </MudTextField>
                <MudTextField Label="Nombre Completo" @bind-Value="usuarioActualizado.Nombre" Required
                    Variant="Variant.Outlined">
                </MudTextField>
            </MudStack>
            <MudStack Row Spacing="7" Class="pb-3">
                <MudTextField Label="Correo" @bind-Value="usuarioActualizado.Correo" Variant="Variant.Outlined">
                </MudTextField>
                <MudSelect T="string" @bind-Value="usuarioActualizado.Rol" Label="Rol" Required
                    Variant="Variant.Outlined">
                    @foreach (var x in roles)
                    {
                        <MudSelectItem Value="@x.Name">@x.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int" @bind-Value="usuarioActualizado.FkUnidad" Label="Unidad" Required
                    Variant="Variant.Outlined">
                    @foreach (var x in Enum.GetValues<Enumerables.Unidades>())
                    {
                        <MudSelectItem Value="@((int)x)">@x</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="ActualizarUsuario">Actualizar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private async Task ActualizarUsuario()
    {
        await _ServicioUsuarios.UpdateUsuario(usuarioActualizado, usuarioActualizadoId);
        await GetUsuarios();
    }
}