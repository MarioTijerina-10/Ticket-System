                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField Label="Nombre Completo" @bind-Value="usuarioActualizado.Nombre" Required
                                  RequiredError="Campo Requerido.." Variant="Variant.Outlined" MaxLength="50" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField Label="Correo" @bind-Value="usuarioActualizado.Correo" Variant="Variant.Outlined"
                                  MaxLength="50" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="string" @bind-Value="usuarioActualizado.Rol" Label="Rol" Required
                               RequiredError="Campo Requerido.." Variant="Variant.Outlined">
                        @foreach (var x in roles)
                        {
                            <MudSelectItem Value="@x.Name">@x.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int?" @bind-Value="unidadSeleccionada" Label="Unidad" Required
                               RequiredError="Campo Requerido.." Variant="Variant.Outlined" Disabled="!ExistenUnidades">
                        @foreach (var x in unidades)
                        {
                            <MudSelectItem Value="@((int?)x.Id)">@x.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int?" @bind-Value="departamentoSeleccionado" Label="Departamento" Required
