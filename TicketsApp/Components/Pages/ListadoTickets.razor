    <DialogContent>
        <MudStack>
            <MudForm @ref="Form_reasignar">
                <MudTextField Label="Observaciones" Required @bind-Value="comentario_reasignacion.Contenido" Lines="3"
                              Class="mb-4" FullWidth="true" />
            </MudForm>
        </MudStack>
        <MudStack Row>
            <MudButton Color="Color.Warning" EndIcon="@Icons.Material.Filled.Backspace" OnClick="ReasignarTicket">
                Reasignar</MudButton>
                <MudButton Color="Color.Secondary" EndIcon="@Icons.Material.Filled.Cancel"
                           OnClick="() => modal_reasignar.CloseAsync() ">Cancelar</MudButton>
            </MudStack>
        </DialogContent>
    </MudDialog>

@code {
    MudDialog modal_reasignar = null!;
    MudForm Form_reasignar = null!;
    CrearComentariosTickets comentario_reasignacion = new();

    private async Task AbrirModal_Reasignar(int Id)
    {
        await modal_reasignar.ShowAsync("Reasignar Ticket", new DialogOptions()
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
        });
        comentario_reasignacion.FkTicket = Id;
    }

    private async Task ReasignarTicket()
    {
        await Form_reasignar.ValidateAsync();

        if (Form_reasignar.IsValid)
        {
            var respuesta = await _ServicioTickets.EditarEstatus((int)comentario_reasignacion.FkTicket!, 2);

            if (respuesta.exitoso == true)
            {
                comentario_reasignacion.Contenido = $"Ticket reasignado: {comentario_reasignacion.Contenido}";
                comentario_reasignacion.FkUsuario = usuario!.Id;
                await _ServicioComentarios.CrearComentario(comentario_reasignacion);
                await GetTickets();

                await filtrar();
                await dataGrid.ReloadServerData();
                await modal_reasignar.CloseAsync();
                comentario_reasignacion = new();

                _Snackbar.Add("El Ticket Fue Abierto de Nuevo Correcamente", severidadInfo);
            }
            else
            {
                _Snackbar.Add($"Hubo un Error al intentar reabrir el Ticket: {respuesta.mensaje}", severidadError);
            }
        }
    }
}

@* //HELPER METHODS *@
@code {
    private string? FormaterTiempo(TimeSpan? tiempo)
    {
        var duracion = tiempo;
        string duracionFormateada = "";
        if (duracion != null)
        {
            duracionFormateada = $"{duracion.Value.Days}d {duracion.Value.Hours}h {duracion.Value.Minutes}m";
        }
        return duracionFormateada;
    }
}