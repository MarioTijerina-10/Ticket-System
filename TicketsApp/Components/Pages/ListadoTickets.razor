@code {
    MudDialog modal_asignar_provedor = null!;
    GetProveedor? provedorAsignado = new();

    private async Task AsignarAProvedor(int Id, string provedor, bool estado)
    {
        var respuesta = await _ServicioTickets.AsignarAProvedor(Id, provedorAsignado!.Id, estado);
        if (respuesta.exitoso == true)
        {
            if (form_asignar_proveedor.IsValid)
            {
                await form_asignar_proveedor.ValidateAsync();
                comentarioNuevo.Contenido = $"Ticket asignado a proveedor:   {provedor}";
                comentarioNuevo.FkTicket = Id;
                comentarioNuevo.FkUsuario = usuario!.Id;

                await _ServicioComentarios.CrearComentario(comentarioNuevo);
                await GetTickets();
                await modal_asignar_provedor.CloseAsync();
                provedorAsignado = proveedores.FirstOrDefault() ?? new GetProveedor();
                _Snackbar.Add(respuesta.mensaje, severidadInfo);
            }
        }
        else
        {
            _Snackbar.Add($"Hubo un Error al Asignara a Proveedor: {respuesta.mensaje}");
        }
    }
}

