</MudGrid>

@code {

    private async Task CambiarTipoDeRegistro(bool valor)
    {
        EsTicketPropio = valor;
        await formTicketNuevo.ResetAsync();
    }

    private int? plantillaId = null;
    private async Task UsarPlantilla(int? value)
    {
        plantillaId = value;
        plantilla = plantillas.FirstOrDefault(p => p.Id == plantillaId) ?? new();
        ticketNuevo.AsignadoAProvedor = plantilla.AsignadoAProvedor;
        ticketNuevo.Asunto = plantilla.Asunto ?? ticketNuevo.Asunto;
        ticketNuevo.Descripcion = plantilla.Descripcion ?? ticketNuevo.Descripcion;
        categoriaSeleccionada = plantilla.FkCategoria != null ? (int)plantilla.FkCategoria : categoriaSeleccionada;
        ticketNuevo.FkProvedor = plantilla.FkProvedor;
        ticketNuevo.RegistroPropio_Razon = plantilla.RegistroPropio_Razon;
        ticketNuevo.Solucion = plantilla.Solucion;
    }
    
    private async Task LimpiarPlantilla()
    {
        ticketNuevo = new();
        categoriaSeleccionada = null;
    }

    @* Buscar Usuarios - CODIGO *@
    private async Task<IEnumerable<GetUsuario>> BuscarUsuarios(string busqueda, CancellationToken token)
    {
        try
        {
            var respuesta = usuarios.Where(x => x.Nombre.Contains(busqueda ?? string.Empty, StringComparison.OrdinalIgnoreCase));
            return respuesta;
        }
        catch (Exception ex)
        {
            _Log.LogError(ex, "Hubo un Error al Intentar Buscar Usuarios");
            return Enumerable.Empty<GetUsuario>();
        }
    }

    @* Al seleccionar el usuario se declarara la llave foranea del usuario y la unidad para el ticket nuevo *@
    private async Task SeleccionarUsuario(GetUsuario usuario)
    {
        @* En caso de borrar usuario buscado evita ser nulo *@
        if (usuario is null)
            return;

        usuarioSeleccionado = usuario;
        ticketNuevo.FkUsuario = usuarioSeleccionado.Id;
        ticketNuevo.FkUnidad = usuarioSeleccionado.FkUnidad;
    }

    
    @* Buscar Proveedores - CODIGO *@
    private async Task<IEnumerable<GetProveedor>> BuscarProveedores(string busqueda, CancellationToken token)
    {
        try
        {
            var respuesta = proveedores.Where(x => x.Nombre.Contains(busqueda ?? string.Empty, StringComparison.OrdinalIgnoreCase));
            return respuesta;
        }
        catch (Exception ex)
        {
            _Log.LogError(ex, "Hubo un Error al Intentar Buscar Proveedores");
            return Enumerable.Empty<GetProveedor>();
        }
    }

    private async Task SeleccionarProveedor(GetProveedor proveedor)
    {
        @* En caso de borrar proveedor buscado evita ser nulo *@
        if (proveedor is null)
            return;

        proveedorSeleccionado = proveedor;
        ticketNuevo.FkProvedor = proveedorSeleccionado.Id;
    }

    @* Actualiza valor del proveedor asignado tambien *@
    private async Task AsignadoAProveedor_Cambio(bool valor)
    {
        ticketNuevo.AsignadoAProvedor = valor;
        proveedorSeleccionado = null;
    }

    @* Comentario Añadido a Observaciones *@
    CrearComentariosTickets nuevoComentario = new();

    private async Task CrearTicket()
    {
        if (enviando)
            return;

        enviando = true;
        try
        {
            await formTicketNuevo.ValidateAsync();
            if (formTicketNuevo.IsValid)
            {
                if (!EsTicketPropio)
                {
                    ticketNuevo.FechaInicio = DateTime.Now;
                    ticketNuevo.FkEstatus = 1;
                    ticketNuevo.FkUnidad = UserData.Unidad;
                    ticketNuevo.FkUsuario = UserData.Id;

                    nuevoComentario.Contenido = $"Ticket fue registrado: {ticketNuevo.Descripcion}";
                    nuevoComentario.FkUsuario = UserData.Id;
                }

                @* Si es ticket propio el estatus automaticamente sera registrador como cerrado *@
                else
                {
                    ticketNuevo.FkEstatus = 4;
                    ticketNuevo.FkAnalista = UserData.Id;
                    ticketNuevo.RegistradoPorAnalista = true;
                    if (ticketNuevo.FechaTomado == null)
                        return;

                    @* Se calculan los tiempo de registro y cierre por el usuario removiendo y añadiendo 5 minutos *@
                    var fechaInicioCalc = (DateTime)(ticketNuevo.FechaTomado - TimeSpan.FromMinutes(5));
                    ticketNuevo.FechaInicio = fechaInicioCalc;

                    var fechaCierreCalc = ticketNuevo.FechaCierreParcial + TimeSpan.FromMinutes(5);
                    ticketNuevo.FechaCierre = fechaCierreCalc;

                    nuevoComentario.Contenido = $"Ticket fue Registrado por Analista: {ticketNuevo.Descripcion}";
                    nuevoComentario.FkUsuario = UserData.Id;
                }

                ticketNuevo.FkCategoria = (int)categoriaSeleccionada!;
                var respuesta = await _ServicioTickets.Createticket(ticketNuevo, nuevoComentario);

                await GetTickets();
                ticketNuevo = new();
                await formTicketNuevo.ResetAsync();
                categoriaSeleccionada = categorias.FirstOrDefault()!.Id;

                _Snackbar.Add(respuesta.mensaje, respuesta.exitoso ? Severity.Success : Severity.Error);
            }
            _Log.LogError("Form no es valido");
            Console.WriteLine("Form no es valido");
        }
        finally
        {
            enviando = false;
        }
    }

    private async Task NavTickets(int estatus)
    {
        _Nav.NavigateTo($"/Tickets?estatus={estatus}");
    }
}
