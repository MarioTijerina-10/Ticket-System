@page "/UsuarioTickets"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using TicketsApp.Components.Razor_Components
@using TicketsApp.DTO
@using TicketsApp.DTO.Tickets
@using TicketsApp.DTO.Categorias
@using TicketsApp.DTO.Usuarios
@using TicketsApp.DTO.Proveedores
@using Microsoft.AspNetCore.Authorization
@using DTO.Comentarios

@inject AuthenticationStateProvider _Auth
@inject ILogger<UsuarioTickets> _Log
@inject ServicioUsuarios _ServicioUsuarios
@inject ServicioTickets _ServicioTickets
@inject ServicioCamposEstaticos _ServicioDatos
@inject ServicioCategorias _ServicioCategorias
@inject ServicioComentarios _ServicioComentarios
@inject ServicioProveedores _ServicioProveedores
@inject IDialogService _ServicioDialogo
@inject UserManager<Usuario> _UserManager
@inject NavigationManager _Nav
@inject ISnackbar _Snackbar

@code {
    CrearTickets ticketNuevo = new();
    List<GetTickets> tickets = new();
    List<GetUsuario> usuarios = new();
    List<GetProveedor> proveedores = new();
    int? ticketsAbiertos = new();
    int? ticketsEnProceso = new();
    int? ticketsCerradosParcial = new();
    int? ticketsCerrados = new();
    int? categoriaSeleccionada = null;
    List<GetCategorias> categorias = new();
    Usuario usuario = new();
    MudForm formTicketNuevo = null!;
    bool EsTicketPropio = false;

    @* Usuaurio Seleccionado en Busqueda *@
    GetUsuario? usuarioSeleccionado = null;

    @* Proveedor Seleccionado en Busqueda *@
    GetProveedor? proveedorSeleccionado = null;

    @* Error desplegado en el Log *@
    Exception error = null!;


    protected override async Task OnInitializedAsync()
    {
        var EstadoAuth = await _Auth.GetAuthenticationStateAsync();
        var EstadoUsuario = EstadoAuth.User;
        usuario = (await _UserManager.GetUserAsync(EstadoUsuario))!;

        await GetTickets();
        await GetUsuarios();
        await GetCategorias();
        await GetProveedores();
    }

    private async Task GetTickets()
    {
        tickets = (await _ServicioTickets.GetAll()).data!;

        ticketsAbiertos = tickets.Where(t => t.FkEstatus == 1 && t.FkUsuario == usuario.Id).Count();
        ticketsEnProceso = tickets.Where(t => t.FkEstatus == 2 && t.FkUsuario == usuario.Id).Count();
        ticketsCerradosParcial = tickets.Where(t => t.FkEstatus == 3 && t.FkUsuario == usuario.Id).Count();
        ticketsCerrados = tickets.Where(t => t.FkEstatus == 4 && t.FkUsuario == usuario.Id).Count();
    }

    private async Task GetUsuarios()
    {
        var usuariosRespuesta = (await _ServicioUsuarios.GetAll()).data;
        usuarios = usuariosRespuesta != null ? usuariosRespuesta : new();
    }

    private async Task GetCategorias()
    {
        categorias = (await _ServicioCategorias.GetCategorias()).data ?? categorias;
        categoriaSeleccionada = categorias.Any() ? categorias.First().Id : null;
    }

    private async Task GetProveedores()
    {
        var proveedoresRespuesta = (await _ServicioProveedores.GetAll()).data;
        proveedores = proveedoresRespuesta != null ? proveedoresRespuesta : new();
    }
}

<MudCard Elevation="1" Outlined="true">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row>
                <MudText Typo="Typo.h6" Class="flex-1">Nuevo Ticket</MudText>

                <MudToggleGroup T="bool" Value="@EsTicketPropio" ValueChanged="@CambiarTipoDeRegistro"
                                Color="Color.Info" Class="flex-1">
                    <MudToggleItem Value="false">Usuario</MudToggleItem>
                    <MudToggleItem Value="true">Analista</MudToggleItem>
                </MudToggleGroup>
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudForm @ref="formTicketNuevo">
            @* Asunto *@
            <MudTextField Label="Asunto" @bind-Value="ticketNuevo.Asunto" Variant=" Variant.Outlined" MaxLength="100"
                          Required>
                Asunto</MudTextField>

                @* Descripcion *@
                <MudTextField Label="Descripcion" @bind-Value="ticketNuevo.Descripcion" Required Variant="Variant.Outlined"
                              Lines="2" MaxLength="250">
                    Descripcion</MudTextField>

                    @* Categoria *@
                    <MudSelect T="int?" @bind-Value="categoriaSeleccionada" Label="Categoria" Required Class="mt-3"
                               Disabled="@(!categorias.Any())" Variant="Variant.Outlined">
                        @foreach (var x in categorias)
                        {
                            <MudSelectItem Value="@((int?)x.Id)">@x.Nombre</MudSelectItem>
                        }
                    </MudSelect>

                    @* Si es ticket subido como usuario aparecera Anydesk, si es subido como un analista para si mismo aparecera
            lo demas *@

                    @if (EsTicketPropio != true)
                    {
                        @* Descripcion *@
                        <MudTextField Label="Anydesk" @bind-Value="ticketNuevo.Anydesk" Variant="Variant.Outlined" MaxLength="20">
                            Anydesk</MudTextField>
                        }
                    else
                        {
                            @* Usuario *@
                            @* Buscar Usuarios - INTERFAZ *@
                            <MudAutocomplete T="GetUsuario" Label="Usuario" Value="@usuarioSeleccionado"
                                             ValueChanged="@SeleccionarUsuario" SearchFunc="BuscarUsuarios" ToStringFunc="u => u?.Nombre"
                                             Clearable="true" ResetValueOnEmptyText="true" CoerceText="false" Class="mt-3" Variant="Variant.Outlined"
                                             Required MaxLength="50" />

                            @* Tiempo de Inicio *@
                            <MudStack Row Class="mt-3">
                                <Componente_DateTime label="Tiempo de Inicio" @bind-fecha_tiempo="@ticketNuevo.FechaTomado" />
                                @* Tiempo de Cierre *@
                                <Componente_DateTime label="Tiempo de Cierre" @bind-fecha_tiempo="@ticketNuevo.FechaCierreParcial" />
                            </MudStack>
                            <MudAlert Severity="Severity.Info" Class="mt-3">Nota: *El tiempo de Inicio y Cierre Se Tomaran Como El
                                Tiempo En Que El
                                Tecnico
                                Inicio y Termino Su Proceso de Trabajo. El Tiempo de Registro Y Cierre por El Usuario Se Registraran 5
                                Minutos Antes y Despues de Este Rango de Tiempo*
                            </MudAlert>

                            @* Solucion *@
                            <MudTextField Label="Solucion" @bind-Value="ticketNuevo.Solucion" Variant="Variant.Outlined" MaxLength="150"
                                          Lines="2" Class="mt-3" Required />

                            @* Razon *@
                            <MudTextField Label="Razon de Registro" @bind-Value="ticketNuevo.RegistroPropio_Razon"
                                          Variant="Variant.Outlined" MaxLength="100" Lines="2" Class="mt-3" Required />

                            @* Asignado a Proveedor *@
                            <MudStack Row Class="mt-3 border border-solid mud-border-info pa-4 ">
                                <MudStack Class="flex-2">
                                    <MudText Typo="Typo.caption">Fue Asignado a Proveedor?</MudText>
                                    <MudRadioGroup T="bool" Value="@ticketNuevo.AsignadoAProvedor"
                                                   ValueChanged="AsignadoAProveedor_Cambio">
                                        <MudRadio Value="false">No</MudRadio>
                                        <MudRadio Value="true">Si</MudRadio>
                                    </MudRadioGroup>
                                </MudStack>

                                @* Buscar Proveedores - INTERFAZ *@

                                <MudStack Class="flex-1">
                                    <MudAutocomplete T="GetProveedor" Label="Provedor" Value="@proveedorSeleccionado"
                                                     ValueChanged="@SeleccionarProveedor" SearchFunc="@BuscarProveedores"
                                                     ToStringFunc="u => u?.Nombre" Clearable="true" ResetValueOnEmptyText="true" CoerceText="false"
                                                     Variant="Variant.Outlined" Disabled="@(!ticketNuevo.AsignadoAProvedor)"
                                                     Required="@(ticketNuevo.AsignadoAProvedor)" Class="mt-6" MaxLength="50" />
                                </MudStack>
                            </MudStack>
                        }

                    </MudForm>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="CrearTicket" FullWidth="true"
                               EndIcon="@Icons.Material.Filled.Send">Enviar</MudButton>
                </MudCardActions>
            </MudCard>

            <MudSpacer />
            <MudStack Row Class="pt-5 d-flex">
                <MudLink Href="/Tickets?estatus=1" Class="flex-1 hover-grow cursor-pointer no-outline">
                    <MudCard Elevation="4" Outlined="true">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Abiertos</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudStack Row>
                                <MudText Typo="Typo.h4">@ticketsAbiertos</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.Announcement" Size="Size.Large"></MudIcon>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudLink>

                <MudLink Href="/Tickets?estatus=2" Class="flex-1 hover-grow cursor-pointer no-outline">
                    <MudCard Elevation="4" Outlined="true">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">En Proceso</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudStack Row>
                                <MudText Typo="Typo.h4">@ticketsEnProceso</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.Build" Size="Size.Large"></MudIcon>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudLink>

                <MudLink Href="/Tickets?estatus=3" Class="flex-1 hover-grow cursor-pointer no-outline">
                    <MudCard Elevation="4" Outlined="true">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Cerrados Por Tecnico</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudStack Row>
                                <MudText Typo="Typo.h4">@ticketsCerradosParcial</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Size="Size.Large"></MudIcon>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudLink>

                <MudLink Href="/Tickets?estatus=4" Class="flex-1 hover-grow cursor-pointer no-outline">
                    <MudCard Elevation="4" Outlined="true" OnClick="@(async () => await NavTickets(1))">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Cerrados</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudStack Row>
                                <MudText Typo="Typo.h4">@ticketsCerrados</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Large"></MudIcon>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudLink>
            </MudStack>

@code {

    private async Task CambiarTipoDeRegistro(bool valor)
    {
        EsTicketPropio = valor;
        await formTicketNuevo.ResetAsync();
    }

    @* Buscar Usuarios - CODIGO *@
    private async Task<IEnumerable<GetUsuario>> BuscarUsuarios(string busqueda, CancellationToken token)
    {
        try
        {
            var respuesta = usuarios.Where(x => x.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase));
            return respuesta;
        }
        catch (Exception ex)
        {
            _Log.LogError(ex, "Hubo un Error al Intentar Buscar Usuarios");
            return Enumerable.Empty<GetUsuario>();
        }
    }

    @* Al seleccionar el usuario se declarara la llave foranea del usuario y la unidad para el ticket nuevo *@
    private async Task SeleccionarUsuario(GetUsuario usuario)
    {
        @* En caso de borrar usuario buscado evita ser nulo *@
        if (usuario is null)
            return;

        usuarioSeleccionado = usuario;
        ticketNuevo.FkUsuario = usuarioSeleccionado.Id;
        ticketNuevo.FkUnidad = usuarioSeleccionado.FkUnidad;
    }

    
    @* Buscar Proveedores - CODIGO *@
    private async Task<IEnumerable<GetProveedor>> BuscarProveedores(string busqueda, CancellationToken token)
    {
        try
        {
            var respuesta = proveedores.Where(x => x.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase));
            return respuesta;
        }
        catch (Exception ex)
        {
            _Log.LogError(ex, "Hubo un Error al Intentar Buscar Proveedores");
            return Enumerable.Empty<GetProveedor>();
        }
    }

    private async Task SeleccionarProveedor(GetProveedor proveedor)
    {
        @* En caso de borrar proveedor buscado evita ser nulo *@
        if (proveedor is null)
            return;

        proveedorSeleccionado = proveedor;
        ticketNuevo.FkProvedor = proveedorSeleccionado.Id;
    }

    @* Actualiza valor del proveedor asignado tambien *@
    private async Task AsignadoAProveedor_Cambio(bool valor)
    {
        ticketNuevo.AsignadoAProvedor = valor;
        proveedorSeleccionado = null;
    }

    @* Comentario Añadido a Observaciones *@
    CrearComentariosTickets nuevoComentario = new();

    private async Task CrearTicket()
    {
        await formTicketNuevo.ValidateAsync();
        if (formTicketNuevo.IsValid)
        {
            if (!EsTicketPropio)
            {
                ticketNuevo.FechaInicio = DateTime.Now;
                ticketNuevo.FkEstatus = 1;
                ticketNuevo.FkUnidad = usuario!.FkUnidad;
                ticketNuevo.FkUsuario = usuario!.Id;

                nuevoComentario.Contenido = $"Ticket fue registrado: {ticketNuevo.Descripcion}";
                nuevoComentario.FkUsuario = usuario.Id;
            }

            @* Si es ticket propio el estatus automaticamente sera registrador como cerrado *@
            else
            {
                ticketNuevo.FkEstatus = 4;
                ticketNuevo.FkAnalista = usuario!.Id;
                ticketNuevo.RegistradoPorAnalista = true;
                if (ticketNuevo.FechaTomado == null)
                    return;

                @* Se calculan los tiempo de registro y cierre por el usuario removiendo y añadiendo 5 minutos *@
                var fechaInicioCalc = (DateTime)(ticketNuevo.FechaTomado - TimeSpan.FromMinutes(5));
                ticketNuevo.FechaInicio = fechaInicioCalc;

                var fechaCierreCalc = ticketNuevo.FechaCierreParcial + TimeSpan.FromMinutes(5);
                ticketNuevo.FechaCierre = fechaCierreCalc;

                nuevoComentario.Contenido = $"Ticket fue Registrado por Analista: {ticketNuevo.Descripcion}";
                nuevoComentario.FkUsuario = usuario.Id;
            }

            ticketNuevo.FkCategoria = (int)categoriaSeleccionada!;
            var respuesta = await _ServicioTickets.Createticket(ticketNuevo, nuevoComentario);

            await GetTickets();
            ticketNuevo = new();
            await formTicketNuevo.ResetAsync();
            categoriaSeleccionada = categorias.FirstOrDefault()!.Id;

            _Snackbar.Add(respuesta.mensaje, Severity.Success);
        }
        _Log.LogError("Form is not valid");
        Console.WriteLine("***********Form is not valid");
    }

    private async Task NavTickets(int estatus)
    {
        _Nav.NavigateTo($"/Tickets?estatus={estatus}");
    }
}