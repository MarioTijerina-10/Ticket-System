@page "/UsuarioTickets"
@attribute [Authorize]
@using System.Security.Claims
@using DTO.Comentarios
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TicketsApp.Components.Razor_Components
@using TicketsApp.DTO
@using TicketsApp.DTO.Categorias
@using TicketsApp.DTO.Plantillas
@using TicketsApp.DTO.Proveedores
@using TicketsApp.DTO.Tickets
@using TicketsApp.DTO.Usuarios

@inject AuthenticationStateProvider _Auth
@inject ILogger<UsuarioTickets> _Log
@inject ServicioUsuarios _ServicioUsuarios
@inject ServicioTickets _ServicioTickets
@inject ServicioCamposEstaticos _ServicioDatos
@inject ServicioCategorias _ServicioCategorias
@inject ServicioComentarios _ServicioComentarios
@inject ServicioProveedores _ServicioProveedores
@inject ServicioPlantillas _ServicioPlantillas
@inject IDialogService _ServicioDialogo
@inject UserManager<Usuario> _UserManager
@inject NavigationManager _Nav
@inject ISnackbar _Snackbar

@code {
    [CascadingParameter(Name = "UserData")]
    UserData UserData { get; set; } = new("", "", 0, 0, "", new());
    CrearTickets ticketNuevo = new();
    GetPlantilla plantilla = new();
    List<GetTickets> tickets = new();
    List<GetPlantilla> plantillas = new();
    List<GetUsuario> usuarios = new();
    List<GetProveedor> proveedores = new();
    int? ticketsAbiertos = new();
    int? ticketsEnProceso = new();
    int? ticketsCerradosParcial = new();
    int? ticketsCerrados = new();
    int? categoriaSeleccionada = null;
    List<GetCategorias> categorias = new();
    MudForm formTicketNuevo = null!;
    bool EsTicketPropio = false;

    @* Evita doble envio y muestra estado de carga en el boton *@
    bool enviando = false;

    @* Usuaurio Seleccionado en Busqueda *@
    GetUsuario? usuarioSeleccionado = null;

    @* Proveedor Seleccionado en Busqueda *@
    GetProveedor? proveedorSeleccionado = null;


    protected override async Task OnInitializedAsync()
    {

        await GetTickets();
        await GetUsuarios();
        await GetCategorias();
        await GetProveedores();
        await GetPlantillas();
    }

    private async Task GetTickets()
    {
        tickets = (await _ServicioTickets.GetAll()).data!;

        ticketsAbiertos = tickets.Where(t => t.FkEstatus == 1 && t.FkUsuario == UserData.Id).Count();
        ticketsEnProceso = tickets.Where(t => t.FkEstatus == 2 && t.FkUsuario == UserData.Id).Count();
        ticketsCerradosParcial = tickets.Where(t => t.FkEstatus == 3 && t.FkUsuario == UserData.Id).Count();
        ticketsCerrados = tickets.Where(t => t.FkEstatus == 4 && t.FkUsuario == UserData.Id).Count();
    }

    private async Task GetUsuarios()
    {
        var usuariosRespuesta = (await _ServicioUsuarios.GetAll()).data;
        usuarios = usuariosRespuesta != null ? usuariosRespuesta : new();
    }

    private async Task GetCategorias()
    {
        categorias = (await _ServicioCategorias.GetCategorias()).data ?? categorias;
    }

    private async Task GetProveedores()
    {
        var proveedoresRespuesta = (await _ServicioProveedores.GetAll()).data;
        proveedores = proveedoresRespuesta != null ? proveedoresRespuesta : new();
    }
    
    private async Task GetPlantillas()
    {
        var plantillasRespuesta = (await _ServicioPlantillas.GetAll(UserData.Id)).data;
        plantillas = plantillasRespuesta != null ? plantillasRespuesta : new(
        );
    }
}

<MudCard Elevation="1" Outlined="true">
    <MudCardHeader>
        <CardHeaderContent>
            <MudGrid Spacing="2" Class="align-center">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.h6">Nuevo Ticket</MudText>
                </MudItem>
                <AuthorizeView Roles="Analista,Admin">
                    <Authorized Context="authContext">
                        <MudItem xs="12" sm="6" Class="d-flex justify-start justify-sm-end">
                            <MudToggleGroup T="bool" Value="@EsTicketPropio" ValueChanged="@CambiarTipoDeRegistro"
                                            Color="Color.Info" CheckMark="true" Disabled="@enviando">
                                <MudToggleItem Value="false">Usuario</MudToggleItem>
                                <MudToggleItem Value="true">Analista</MudToggleItem>
                            </MudToggleGroup>
                        </MudItem>
                    </Authorized>
                </AuthorizeView>
            </MudGrid>
            @if (EsTicketPropio)
            {
                <MudDivider Class="mt-4 mb-4" />
                <MudSelect T="int?" Value="plantillaId" ValueChanged="UsarPlantilla" Clearable
                           OnClearButtonClick="@LimpiarPlantilla" Label="Plantilla" Variant="Variant.Filled"
                           Placeholder="Selecciona una plantilla (opcional)" AnchorOrigin="Origin.BottomCenter"
                           Disabled="@(!plantillas.Any())"
                           HelperText="@(plantillas.Any() ? "Rellena el formulario automaticamente" : "No tienes plantillas guardadas")">
                    @foreach (var x in plantillas)
                    {
                        <MudSelectItem Value="@((int?)x.Id)">@x.Nombre</MudSelectItem>
                    }
                </MudSelect>
                <MudDivider Class="mt-4" />
            }
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="pt-0">
        <MudForm @ref="formTicketNuevo">
            @* Asunto *@
            <MudTextField Label="Asunto" @bind-Value="ticketNuevo.Asunto" Variant="Variant.Outlined" MaxLength="100"
                          Required RequiredError="Campo Requerido.." Immediate="true" Counter="100" 
                          Clearable="true" Placeholder="Resumen breve del problema" />

            @* Descripcion *@
            <MudTextField Label="Descripcion" @bind-Value="ticketNuevo.Descripcion" Required
                          RequiredError="Campo Requerido.." Variant="Variant.Outlined" Lines="2" MaxLength="250" Immediate="true"
                          Counter="250" MaxLines="6" Class="mt-3"
                          Placeholder="Describe el problema con el mayor detalle posible" />

            @* Categoria *@
            <MudSelect T="int?" @bind-Value="categoriaSeleccionada" Label="Categoria" Required
                       RequiredError="Campo Requerido.." Class="mt-3" Disabled="@(!categorias.Any())"
                       Variant="Variant.Outlined" Clearable="true" Placeholder="Selecciona una categoria"
                       AnchorOrigin="Origin.BottomCenter">
                @foreach (var x in categorias)
                {
                    <MudSelectItem Value="@((int?)x.Id)">@x.Nombre</MudSelectItem>
                }
            </MudSelect>

            @* Si es ticket subido como usuario aparecera Anydesk, si es subido como un analista para si mismo aparecera
            lo demas *@

            @if (EsTicketPropio != true)
            {
                @* Descripcion *@
                <MudTextField Label="Anydesk" @bind-Value="ticketNuevo.Anydesk" Variant="Variant.Outlined" MaxLength="20"
                              Immediate="true" Counter="20" Clearable="true" Class="mt-3" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.DesktopWindows" Placeholder="Ej. 123 456 789"
                              HelperText="Opcional" />
            }
            else
            {
                @* Usuario *@
                @* Buscar Usuarios - INTERFAZ *@
                <MudAutocomplete T="GetUsuario" Label="Usuario" Value="@usuarioSeleccionado"
                                 ValueChanged="@SeleccionarUsuario" SearchFunc="BuscarUsuarios" ToStringFunc="u => u?.Nombre"
                                 Clearable="true" ResetValueOnEmptyText="true" CoerceText="false" Class="mt-3" Variant="Variant.Outlined"
                                 Required RequiredError="Campo Requerido.." MaxLength="50" DebounceInterval="250" OpenOnFocus="true"
                                 SelectValueOnTab="true" ShowProgressIndicator="true" Placeholder="Escribe para buscar un usuario"
                                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search">
                    <NoItemsTemplate>
                        <MudText Align="Align.Center" Class="px-4 py-1">Sin resultados</MudText>
                    </NoItemsTemplate>
                </MudAutocomplete>

                @* Tiempo de Inicio *@
                <MudGrid Spacing="2" Class="mt-1">
                    <MudItem xs="12" sm="6">
                        <Componente_DateTime label="Tiempo de Inicio" @bind-fecha_tiempo="@ticketNuevo.FechaTomado" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <Componente_DateTime label="Tiempo de Cierre"
                                             @bind-fecha_tiempo="@ticketNuevo.FechaCierreParcial" />
                    </MudItem>
                </MudGrid>
                <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">Nota: *El tiempo de Asignacion y Cierre Parcial
                    Se Tomaran
                    de Estos Inputs. El Tiempo de Registro Y Cierre por El Usuario Se Registraran 5
                    Minutos Antes y Despues de Este Rango de Tiempo*
                </MudAlert>

                @* Solucion *@
                <MudTextField Label="Solucion" @bind-Value="ticketNuevo.Solucion" Variant="Variant.Outlined" MaxLength="150"
                              Lines="2" Class="mt-3" Required RequiredError="Campo Requerido.." Immediate="true" Counter="150"
                              MaxLines="6" Placeholder="Que se hizo para resolver el problema" />

                @* Razon *@
                <MudTextField Label="Razon de Registro" @bind-Value="ticketNuevo.RegistroPropio_Razon"
                              Variant="Variant.Outlined" MaxLength="100" Lines="2" Class="mt-3" Required
                              RequiredError="Campo Requerido.." Immediate="true" Counter="100" MaxLines="6"
                              Placeholder="Por que se registra este ticket de forma propia" />

                @* Asignado a Proveedor *@
                <MudGrid Spacing="2" Class="mt-3 border border-solid mud-border-info pa-2 mx-0" Style="width:100%">
                    <MudItem xs="12" md="5">
                        <MudText Typo="Typo.caption">Fue Asignado a Proveedor?</MudText>
                        <MudRadioGroup T="bool" Value="@ticketNuevo.AsignadoAProvedor"
                                       ValueChanged="AsignadoAProveedor_Cambio">
                            <MudRadio Value="false" Color="Color.Info">No</MudRadio>
                            <MudRadio Value="true" Color="Color.Info">Si</MudRadio>
                        </MudRadioGroup>
                    </MudItem>

                    <MudItem xs="12" md="7">
                        <MudAutocomplete T="GetProveedor" Label="Provedor" Value="@proveedorSeleccionado"
                                         ValueChanged="@SeleccionarProveedor" SearchFunc="@BuscarProveedores"
                                         ToStringFunc="u => u?.Nombre" Clearable="true" ResetValueOnEmptyText="true" CoerceText="false"
                                         Variant="Variant.Outlined" Disabled="@(!ticketNuevo.AsignadoAProvedor)"
                                         Required="@(ticketNuevo.AsignadoAProvedor)" RequiredError="Campo Requerido.." MaxLength="50"
                                         DebounceInterval="250" OpenOnFocus="true" SelectValueOnTab="true" ShowProgressIndicator="true"
                                         Placeholder="Escribe para buscar un proveedor" Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Search">
                            <NoItemsTemplate>
                                <MudText Align="Align.Center" Class="px-4 py-1">Sin resultados</MudText>
                            </NoItemsTemplate>
                        </MudAutocomplete>
                    </MudItem>
                </MudGrid>
            }

        </MudForm>
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="CrearTicket" FullWidth="true"
                   Disabled="@enviando" ButtonType="ButtonType.Button"
                   EndIcon="@(enviando ? null : Icons.Material.Filled.Send)">
            @if (enviando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>Enviando...</span>
            }
            else
            {
                <span>Enviar</span>
            }
        </MudButton>
    </MudCardActions>
</MudCard>

<MudSpacer />

<MudGrid Spacing="3" Class="pt-5">
    <MudItem xs="12" sm="6" md="3">
        <MudLink Href="/Tickets?estatus=1" Class="d-block h-100 hover-grow cursor-pointer no-outline"
