@code {
    UpdatePlantilla plantillaEditada = new();
    MudDialog DialogoEditarPlantilla = default!;
    MudForm FormEditarPlantilla = default!;
    int EditId;

    private async Task Abrir_ModalEditar(GetPlantilla plantilla)
    {
        plantillaEditada.AsignadoAProvedor = plantilla.AsignadoAProvedor;
        plantillaEditada.Asunto = plantilla.Asunto;
        plantillaEditada.Descripcion = plantilla.Descripcion;
        plantillaEditada.FkCategoria = plantilla.FkCategoria;
        plantillaEditada.FkProvedor = plantilla.FkProvedor;
        plantillaEditada.Nombre = plantilla.Nombre;
        plantillaEditada.RegistroPropio_Razon = plantilla.RegistroPropio_Razon;
        plantillaEditada.Solucion = plantilla.Solucion;
        await DialogoEditarPlantilla.ShowAsync($"Editar Plantilla {plantilla.Nombre}", new DialogOptions()
        {
            MaxWidth = MaxWidth.Medium
        });
        EditId = plantilla.Id;
    }

    private async Task EditarPlantilla()
    {
        var respuesta = await _ServicioPlantillas.UpdatePlantilla(plantillaEditada, EditId);
        EnseñarAlerta(respuesta.mensaje, respuesta.exitoso);

        await GetPlantillas();
        await DialogoEditarPlantilla.CloseAsync();
        plantillaEditada = new();
    }

    private async Task EliminarPlantilla(int Id)
    {
        var respuesta = await _ServicioPlantillas.EliminarPlantilla(Id);
        EnseñarAlerta(respuesta.mensaje, respuesta.exitoso);
        await GetPlantillas();
    }

    private void EnseñarAlerta(string mensaje, bool exitoso)
    {
        _Snackbar.Add(mensaje, exitoso ? Severity.Success : Severity.Error);
    }
}
